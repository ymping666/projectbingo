---
import { withBase } from '../../lib/url';
import Layout from '../../layouts/Layout.astro';
import { templates } from '../../lib/templates';
import { sampleProject, sampleFilename } from '../../lib/samples';
import { featured, related } from '../../lib/template-content';
import { CardView } from '../../components/shared';
import AdSlot from '../../components/AdSlot.astro';
export function getStaticPaths() {
  return templates.map((t) => ({ params: { slug: t.id }, props: { t } }));
}
const { t } = Astro.props;
const p = sampleProject(t);
const content = featured[t.id];
const recommendations = (t.relatedIds || related[t.id] || []).map(
  (id) => templates.find((other) => other.id === id)!,
);
---

<Layout title={`${t.name} Bingo cards`} description={t.description}
  ><div class="breadcrumbs">
    <a href={withBase('/templates/')}>All templates</a><span>/</span>{t.name}
  </div><section class="template-detail">
    <div>
      <div class="eyebrow">{t.category.toUpperCase()}</div><h1>
        {t.name}<br /><em>Bingo.</em>
      </h1><p class="detail-description">{t.description}</p><div
        class="detail-tags"
      >
        <span>{t.words.length} words</span><span>{t.size} × {t.size} grid</span
        ><span>Free to customize</span>
      </div><a
        class="button primary"
        href={withBase(`/?template=${t.id}`)}
        data-template-use={t.id}
        data-template-size={t.size}>Use this template <span>↗</span></a
      ><h2>At your next gathering</h2><p>{t.tip}</p><p>
        {
          t.mode === 'observed'
            ? 'Print different layouts, then mark matching events or phrases as you observe them. Agree on matches and confirm lines manually. No random website calling or automatic event verification is needed.'
            : 'Print one distinct card per player. Call words from this list and mark a full row, column or diagonal. The optional FREE center starts marked.'
        }
      </p><a href={withBase('/how-to-play/')}>Read the full rules ↗</a>
    </div><div class="template-sample">
      <CardView project={p} card={p.cards[0]} /><p>
        Sample card. {
          t.mode === 'observed'
            ? 'Generate your own cards before playing by observation.'
            : 'Generate your own activity before hosting.'
        }
      </p>
      <p>
        For this look in the card maker, open Appearance and choose Theme
        colors.
      </p>
    </div>
  </section>
  {
    t.notes && (
      <article class="article">
        {t.notes.map((note: string, i: number) => (
          <section>
            <h2>
              {
                [
                  'Purpose and preparation',
                  'Play this activity',
                  'Grid and printing choices',
                ][i]
              }
            </h2>
            <p>{note}</p>
          </section>
        ))}
        {t.source && (
          <p>
            Source: <a href={t.source.url}>{t.source.label}</a>
          </p>
        )}
        <p>
          After editing, generation validates the actual deduplicated pool. 5 ×
          5 needs 24 distinct entries with FREE or 25 without it; 3 × 3 needs
          eight or nine.
        </p>
      </article>
    )
  }
  {
    content && (
      <article class="article template-notes">
        <section>
          <>
            <h2>A game for your group</h2>
            <p>{content.scene}</p>
          </>
        </section>
        <section>
          <>
            <h2>Suggested settings</h2>
            <p>{content.settings}</p>
          </>
        </section>
        <section>
          <>
            <h2>Prepare and play</h2>
            <ol>
              {content.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </>
        </section>
        <section>
          <>
            <h2>Try these calls and conversations</h2>
            <ul>
              {content.examples.map((example) => (
                <li>{example}</li>
              ))}
            </ul>
          </>
        </section>
        <section>
          <>
            <h2>Download an example game pack</h2>
            <p>
              See two sample cards, the complete caller list and the rules in a
              real A4 PDF, with two cards per page. The card shown above belongs
              to this sample.
            </p>
          </>
          <a
            class="button secondary"
            href={withBase(`/samples/${sampleFilename(t.id)}`)}
            download
            data-sample-download={t.id}
          >
            Download sample PDF
          </a>
          <p>
            This is a fixed example, separate from the activity saved in your
            browser. To host your own cards with the web checker, use this
            template, generate a new card set, save its project JSON and start
            hosting that same activity.
          </p>
        </section>
      </article>
    )
  }
  {
    t.id === 'sight-word-bingo' && (
      <section class="article">
        <>
          <h2>Word list source</h2>
          <p>
            The list below matches the complete 40-word Dolch Pre-K group
            published by{' '}
            <a href="https://sightwords.com/sight-words/dolch/" rel="external">
              Sightwords.com
            </a>{' '}
            and its{' '}
            <a
              href="https://sightwords.com/pdfs/word_lists/dolch_prek.pdf"
              rel="external"
            >
              Pre-K list PDF
            </a>
            , checked October 22, 2026. No extra words have been added. Editing
            it creates your own selection; the maker validates the remaining
            distinct entries.
          </p>
        </>
      </section>
    )
  }
  {
    t.variants && (
      <section class="article">
        <p>
          Both presets contain 26 separate letters. Each button loads only that
          case into the maker as edits, not a newly generated activity.
        </p>
        {t.variants.map((v) => {
          const variantProject = sampleProject(t, v.id);
          return (
            <section>
              <h3>{v.name}</h3>
              <p>{v.words.join(' · ')}</p>
              <div class="template-sample">
                <CardView
                  project={variantProject}
                  card={variantProject.cards[0]}
                />
              </div>
              <div class="related-links">
                <a
                  class="button secondary"
                  href={withBase(`/?template=${t.id}&preset=${v.id}`)}
                  data-template-use={t.id}
                  data-template-size={t.size}
                >
                  Use {v.name}
                </a>
                <a
                  href={withBase(
                    `/samples/${sampleFilename(`${t.id}-${v.id}`)}`,
                  )}
                  download
                  data-sample-download={t.id}
                >
                  Download {v.name} sample PDF
                </a>
              </div>
              <p>
                Fixed sample only. Generate your own activity before using the
                web host or checker.
              </p>
            </section>
          );
        })}
      </section>
    )
  }
  {
    (t.notes || (!content && !t.variants)) && (
      <section class="article">
        <>
          <h2>Inspect a fixed sample</h2>
          <p>
            This A4 PDF contains two example cards, a checklist and rules. It is
            separate from your saved activity.{' '}
            {t.mode === 'observed'
              ? 'Play by observation and confirm wins manually.'
              : 'To use the web host, generate your own cards and retain that project JSON.'}
          </p>
          <a
            class="button secondary"
            href={withBase(`/samples/${sampleFilename(t.id)}`)}
            download
            data-sample-download={t.id}
          >
            Download sample PDF
          </a>
        </>
      </section>
    )
  }
  <section class="word-pool">
    <div class="section-title">
      <div>
        <div class="section-eyebrow">WHAT’S IN THE GAME</div><h2>
          The complete word list
        </h2>
      </div><span>{t.words.length} distinct entries</span>
    </div><ul>{t.words.map((w: string) => <li>{w}</li>)}</ul>
  </section><section class="article related">
    <h2>Make it work for your group</h2><p>
      Choose A4 or US Letter in portrait orientation. One card per page gives
      the most room; two is a useful everyday choice. Check your PDF before
      printing and use Actual size (100%). Long phrases may need fewer cards per
      page.
    </p><p>
      <a href={withBase('/classroom-bingo/')}>Plan a classroom game</a> · <a
        href={withBase('/blank-bingo-cards/')}>Print handwriting grids</a
      >
    </p><h2>Keep exploring</h2><div class="related-links">
      {
        recommendations.map((other) => (
          <a href={withBase(`/templates/${other.id}/`)}>{other.name} ↗</a>
        ))
      }
    </div>
    <p>
      <a href={withBase('/educational-bingo/')}>Choose a learning goal</a> · <a
        href={withBase('/holiday-bingo/')}>Browse seasons and celebrations</a
      > · <a
        href={withBase(
          t.mode === 'observed' ? '/office-icebreaker-bingo/' : '/esl-bingo/',
        )}
        >{
          t.mode === 'observed'
            ? 'Organize an icebreaker'
            : 'Plan vocabulary practice'
        }</a
      >
    </p>
  </section><AdSlot /></Layout
>
