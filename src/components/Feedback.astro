---
import { config } from '../lib/config';
import { feedbackFormUrl } from '../lib/feedback';
import { routePath, withBase } from '../lib/url';
const formUrl = feedbackFormUrl(config.feedbackFormUrl);
const floating = !['/host/', '/bingo-caller/'].includes(
  routePath(Astro.url.pathname),
);
---

{
  formUrl && (
    <>
      {floating && (
        <a
          href={formUrl}
          class="feedback-launcher"
          data-feedback-open
          aria-haspopup="dialog"
          aria-controls="feedback-dialog"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <path
              d="M20 11.5a8 8 0 0 1-8 8H5l-4 3 1.7-6A8 8 0 1 1 20 11.5Z"
              transform="translate(1 -1) scale(.95)"
            />
            <path d="M7 9h9M7 13h6" />
          </svg>
          Feedback
        </a>
      )}
      <dialog
        id="feedback-dialog"
        class="feedback-dialog"
        aria-labelledby="feedback-title"
        aria-describedby="feedback-description"
      >
        <div class="feedback-surface">
          <header class="feedback-heading">
            <img
              src={withBase('/favicon.svg?v=2')}
              width="32"
              height="32"
              alt=""
            />
            <button
              type="button"
              class="feedback-close"
              data-feedback-close
              aria-label="Close feedback"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <path d="m6 6 12 12M18 6 6 18" />
              </svg>
            </button>
            <div class="section-eyebrow">A LITTLE NOTE GOES A LONG WAY</div>
            <h2 id="feedback-title">Help shape the next game.</h2>
            <p id="feedback-description">
              Something not working? Have an idea? We'd love to hear it.
            </p>
          </header>
          <ul class="feedback-options">
            <li>
              <>
                <span aria-hidden="true">↳</span>
                <div>
                  <>
                    <strong>Report a problem</strong>
                    <span>Tell us what happened and what you expected.</span>
                  </>
                </div>
              </>
            </li>
            <li>
              <>
                <span aria-hidden="true">✧</span>
                <div>
                  <>
                    <strong>Suggest an improvement</strong>
                    <span>A small idea for your next activity? Share it.</span>
                  </>
                </div>
              </>
            </li>
            <li>
              <>
                <span aria-hidden="true">…</span>
                <div>
                  <>
                    <strong>Something else</strong>
                    <span>There's room for that, too.</span>
                  </>
                </div>
              </>
            </li>
          </ul>
          <a
            class="button dark feedback-continue"
            href={formUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Write feedback <span aria-hidden="true">↗</span>
          </a>
          <p class="feedback-hint">
            Opens Google Forms in a new tab. No sign-in required.
          </p>
          <p class="feedback-privacy">
            Your reply email is optional. Feedback is received privately through
            Google Forms; no cards, words or project files are attached
            automatically. Please leave out passwords and student details.{' '}
            <a href={withBase('/privacy/')}>Privacy</a>
          </p>
        </div>
      </dialog>
    </>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#feedback-dialog');
  if (dialog && typeof dialog.showModal === 'function') {
    let opener: HTMLElement | null = null;
    let previousOverflow = '';
    document
      .querySelectorAll<HTMLAnchorElement>('[data-feedback-open]')
      .forEach((link) => {
        link.addEventListener('click', (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
            return;
          event.preventDefault();
          if (dialog.open) return;
          opener = link;
          previousOverflow = document.body.style.overflow;
          document.body.style.overflow = 'hidden';
          dialog.showModal();
        });
      });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      opener?.focus();
    });
    dialog
      .querySelector('[data-feedback-close]')!
      .addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      )
        dialog.close();
    });
  }
</script>

<style>
  .feedback-launcher {
    position: fixed;
    z-index: 30;
    right: 24px;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    padding: 11px 17px;
    border: 1px solid #d4dcd2;
    border-radius: 30px;
    background: #fffefa;
    color: #304b3e;
    font-size: 13px;
    box-shadow: 0 4px 18px #203d3010;
  }
  .feedback-launcher:hover {
    background: #edf1e6;
    text-decoration: none;
  }
  .feedback-dialog {
    padding: 0;
    width: min(500px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 40px);
    border: 1px solid #dce2d6;
    border-radius: 20px;
    background: #fffefa;
    color: #273d35;
    box-shadow: 0 32px 100px #0e251c3d;
    overflow-y: auto;
  }
  .feedback-dialog::backdrop {
    background: #1a2c2566;
    backdrop-filter: blur(4px);
  }
  .feedback-surface {
    padding: 30px 32px 24px;
  }
  .feedback-heading {
    position: relative;
  }
  .feedback-heading > img {
    margin-bottom: 22px;
  }
  .feedback-close {
    position: absolute;
    top: -8px;
    right: -10px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }
  .feedback-close:hover {
    background: #eef1e9;
  }
  .feedback-heading .section-eyebrow {
    font-size: 9px;
    letter-spacing: 1.6px;
    margin-bottom: 10px;
  }
  .feedback-heading h2 {
    font-family: Georgia, serif;
    font-size: 30px;
    font-weight: 400;
    letter-spacing: -0.8px;
    margin-bottom: 10px;
  }
  .feedback-heading p {
    font-size: 13px;
    margin-bottom: 22px;
  }
  .feedback-options {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    border-top: 1px solid #e7e9e0;
  }
  .feedback-options li {
    display: flex;
    gap: 14px;
    padding-top: 17px;
  }
  .feedback-options li > span {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 9px;
    background: #edf2e3;
    font-size: 20px;
  }
  .feedback-options li:nth-child(2) > span {
    background: #f0eaf5;
  }
  .feedback-options strong {
    display: block;
    font-size: 13px;
    margin-bottom: 4px;
  }
  .feedback-options div > span {
    display: block;
    color: #74806f;
    font-size: 12px;
    line-height: 1.5;
  }
  .feedback-continue {
    width: 100%;
    justify-content: space-between;
  }
  .feedback-hint {
    text-align: center;
    font-size: 11px;
    margin: 11px 0 20px;
  }
  .feedback-privacy {
    padding-top: 14px;
    border-top: 1px solid #e7e9e0;
    font-size: 11px;
    margin: 0;
  }
  .feedback-privacy a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (max-width: 540px) {
    .feedback-launcher {
      bottom: max(14px, env(safe-area-inset-bottom));
      right: 14px;
      padding: 10px 14px;
    }
    .feedback-dialog {
      max-height: calc(100dvh - 24px);
      width: calc(100vw - 24px);
      border-radius: 16px;
    }
    .feedback-surface {
      padding: 25px 20px 20px;
    }
    .feedback-heading h2 {
      font-size: 27px;
    }
  }
  @media print {
    .feedback-launcher,
    .feedback-dialog {
      display: none !important;
    }
  }
</style>
