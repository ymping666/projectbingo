---
import '../styles/global.css';
import { config } from '../lib/config';
const { title, description, noindex = false } = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const blocked = noindex || !Astro.site;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><title>{title} | {config.name}</title><meta
      name="description"
      content={description}
    /><meta
      name="robots"
      content={blocked ? 'noindex, nofollow' : 'index, follow'}
    />{canonical && <link rel="canonical" href={canonical} />}<meta
      property="og:title"
      content={`${title} | ${config.name}`}
    /><meta property="og:description" content={description} /><meta
      property="og:type"
      content="website"
    />{canonical && <meta property="og:url" content={canonical} />}<link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    /><link
      rel="preload"
      href="/fonts/Lato-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />{
      !blocked && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': path === '/' ? 'WebApplication' : 'WebPage',
            name: title,
            description,
            url: canonical,
            ...(path === '/'
              ? {
                  applicationCategory: 'EducationalApplication',
                  operatingSystem: 'Any',
                  offers: {
                    '@type': 'Offer',
                    price: '0',
                    priceCurrency: 'USD',
                  },
                }
              : {}),
          })}
        />
      )
    }</head
  ><body
    ><a class="skip-link" href="#main">Skip to content</a><header
      class="site-header"
    >
      <a href="/" class="brand" aria-label="Bingo Print Kit home"
        ><span class="brand-mark" aria-hidden="true"
          ><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span
        ><span>Bingo<span class="brand-light"> Print Kit</span></span></a
      ><nav aria-label="Main navigation">
        <a class:list={{ active: path === '/' }} href="/">Card maker</a><a
          class:list={{ active: path.startsWith('/templates/') }}
          href="/templates/">Templates</a
        ><a
          class:list={{ active: path === '/how-to-play/' }}
          href="/how-to-play/">How to play</a
        ><a class="host-nav" href="/host/"
          >Host a game <span aria-hidden="true">↗</span></a>
      </nav>
    </header><main id="main"><slot /></main><footer class="site-footer">
      <a class="footer-brand" href="/"
        >Bingo Print Kit <span>A little prep. A lot of play.</span></a
      ><div>
        <a href="/printing-guide/">Printing guide</a><a href="/about/">About</a
        ><a href="/privacy/">Privacy</a>{
          config.contactEmail && (
            <a href={`mailto:${config.contactEmail}`}>Contact</a>
          )
        }
      </div><p>Made for shared tables, classrooms, and good company.</p>
    </footer></body>
</html>
