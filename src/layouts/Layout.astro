---
import { withBase, routePath } from '../lib/url';
import '../styles/global.css';
import { config } from '../lib/config';
import { deployment, productionOrigin } from '../lib/deployment';
import { analyticsConfigured } from '../lib/analytics';
import AnalyticsConsent from '../components/AnalyticsConsent';
const { title, description, noindex = false } = Astro.props;
const canonical =
  deployment.indexable && !noindex
    ? new URL(Astro.url.pathname, productionOrigin).href
    : undefined;
const blocked = noindex || !deployment.indexable;
const path = routePath(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><title>{title} | {config.name}</title><meta
      name="description"
      content={description}
    /><meta
      name="robots"
      content={blocked ? 'noindex, nofollow' : 'index, follow'}
    />{canonical && <link rel="canonical" href={canonical} />}<meta
      property="og:title"
      content={`${title} | ${config.name}`}
    /><meta property="og:description" content={description} /><meta
      property="og:type"
      content="website"
    />{canonical && <meta property="og:url" content={canonical} />}<meta
      property="og:image"
      content={new URL(
        withBase('/social-card.svg'),
        Astro.site || Astro.url.origin,
      ).href}
    /><meta
      property="og:image:alt"
      content="Bingo Card Kit — make, print and host word Bingo"
    /><link
      rel="icon"
      type="image/svg+xml"
      href={withBase('/favicon.svg')}
    /><link
      rel="preload"
      href={withBase('/fonts/Lato-Regular.ttf')}
      as="font"
      type="font/ttf"
      crossorigin
    />{
      !blocked && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': path === '/' ? 'WebApplication' : 'WebPage',
            name: title,
            description,
            url: canonical,
            ...(path === '/'
              ? {
                  applicationCategory: 'EducationalApplication',
                  operatingSystem: 'Any',
                  offers: {
                    '@type': 'Offer',
                    price: '0',
                    priceCurrency: 'USD',
                  },
                }
              : {}),
          })}
        />
      )
    }</head
  ><body
    data-deployment={deployment.target}
    data-indexable={String(deployment.indexable)}
    ><a class="skip-link" href="#main">Skip to content</a>
    {
      deployment.target === 'preview' && (
        <aside class="migration-banner">
          Our main site is now <a href={productionOrigin}>bingocardkit.com</a>.
          To move an existing activity, save its project JSON here, then import
          it on the main site. Your old activities remain available here.
        </aside>
      )
    }
    <header class="site-header">
      <a href={withBase('/')} class="brand" aria-label="Bingo Card Kit home"
        ><span class="brand-mark" aria-hidden="true"
          ><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span
        ><span>Bingo<span class="brand-light"> Card Kit</span></span></a
      ><nav aria-label="Main navigation">
        <a class:list={{ active: path === '/' }} href={withBase('/')}
          >Card maker</a
        ><a
          class:list={{ active: path.startsWith('/templates/') }}
          href={withBase('/templates/')}>Templates</a
        ><a
          class:list={{ active: path === '/how-to-play/' }}
          href={withBase('/how-to-play/')}>How to play</a
        ><a class="host-nav" href={withBase('/host/')}
          >Host a game <span aria-hidden="true">↗</span></a
        >
      </nav>
    </header><main id="main"><slot /></main><footer class="site-footer">
      <a class="footer-brand" href={withBase('/')}
        >Bingo Card Kit <span>A little prep. A lot of play.</span></a
      ><div>
        <a href={withBase('/printing-guide/')}>Printing guide</a><a
          href={withBase('/about/')}>About</a
        ><a href={withBase('/privacy/')}>Privacy</a>{
          config.contactEmail && (
            <a href={`mailto:${config.contactEmail}`}>Contact</a>
          )
        }
        {analyticsConfigured && <AnalyticsConsent client:load />}
      </div><p>Made for shared tables, classrooms, and good company.</p>
    </footer>
    <script>
      import { track } from '../lib/analytics';
      document.addEventListener('click', (event) => {
        const link =
          event.target instanceof Element
            ? event.target.closest<HTMLAnchorElement>('a[data-template-use]')
            : null;
        if (link)
          track('template_used', {
            templateId: link.dataset.templateUse,
            size: Number(link.dataset.templateSize),
          });
      });
    </script>
  </body>
</html>
