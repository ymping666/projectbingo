# npm run build:production fixes the formal origin and root base; default indexable.
# npm run build:preview always uses /projectbingo/, noindex and no statistics.
# INDEXABLE_BUILD=false
# Optional, real approved address only; empty hides Contact.
PUBLIC_CONTACT_EMAIL=
# GA4 stays off until BOTH are set after disabling ALL Enhanced Measurement options.
PUBLIC_GA4_ID=
PUBLIC_GA4_MANUAL_ONLY=false
